#define name QR VCard Share
#define color orange

#include 'actions/calendar'
#include 'actions/contacts'
#include 'actions/crypto'
#include 'actions/documents'
#include 'actions/images'
#include 'actions/sharing'
#include 'actions/text'
#include 'actions/web'

// Show your own or any contact's details as a vCard QR code to scan, or share them with other
// apps as a contact file. Sharing profiles choose the fields and, by label, which phone numbers,
// emails and addresses go in. Settings live in the Shortcuts folder under QRVCard/:
//   identity.vcf              your contact card, to find it in Contacts each run (identity_lookup.cherri)
//   profiles/                 the sharing profiles (profiles.cherri)
//   cache/<profile>/          hashed answers to earlier prompts, per contact (select_lines.cherri)

// "show" displays the QR card on screen; "share" sends a .vcf through the share sheet;
// "profiles" manages the sharing profiles; "selftest" (run with the text "selftest" or
// "selftest-sparse" as input) renders a made-up contact without any menus or files, for checking
// from the command line.
//
// Text input can also skip the menu, for one-tap launchers (a shortcut that runs this one with a
// fixed input): "show" or "share" for your own card, "show-contact" or "share-contact" for a
// contact you pick, each optionally followed by ":" and a profile name, e.g. "show:Business".
// An unknown profile name falls back to the profile list.
@Mode = ""
// "identity" uses the saved identity; "pick" asks for a contact; "selftest" uses selftest.cherri.
@Source = ""

// Release identity. latest.json in the repository holds the newest released version and the iCloud
// link to install it, so the shortcut never needs to know its own install link.
const AppVersion = "1.1.0"
const ProjectURL = "https://github.com/gtjeffw/qrcode-vcard"
const LatestURL = "https://raw.githubusercontent.com/gtjeffw/qrcode-vcard/main/latest.json"
@InputText = "{ShortcutInput}"
if @InputText beginsWith "selftest" {
    @Mode = "selftest"
    @Source = "selftest"
} else {
    createFolder("QRVCard")
    const CommandRaw = replaceText('^\s*([A-Za-z-]+)(?::.*)?\s*$', '$1', @InputText, true, true)
    const CommandLower = lowercase(CommandRaw)
    @Command = "{CommandLower}"
    const RequestedRaw = replaceText('^\s*[A-Za-z-]+:?', '', @InputText, true, true)
    const RequestedTrimmed = trimWhitespace(RequestedRaw)
    @RequestedProfile = "{RequestedTrimmed}"
    if @Command == "show" {
        @Mode = "show"
        @Source = "identity"
    }
    if @Command == "share" {
        @Mode = "share"
        @Source = "identity"
    }
    if @Command == "show-contact" {
        @Mode = "show"
        @Source = "pick"
    }
    if @Command == "share-contact" {
        @Mode = "share"
        @Source = "pick"
    }
}
if @Mode == "" {
    @RequestedProfile = ""
    menu "QR VCard Share" {
        item "Show my QR VCard":
            @Mode = "show"
            @Source = "identity"
        item "Show a contact's QR VCard":
            @Mode = "show"
            @Source = "pick"
        item "Share my VCard":
            @Mode = "share"
            @Source = "identity"
        item "Share a contact's VCard":
            @Mode = "share"
            @Source = "pick"
        item "Set your Identity":
            const IdentityContact = selectContact()
            saveFile("QRVCard/identity.vcf", IdentityContact, true)
            alert("Identity saved.", "QR VCard Share")
            stop()
        item "Manage profiles":
            @Mode = "profiles"
            @Source = "identity"
        item "About":
            @Mode = "about"
    }
}

if @Mode == "about" {
    menu "QR VCard Share {AppVersion}" {
        item "Check for updates":
            // Fetched only when asked for; nothing else in the shortcut uses the network.
            const LatestResponse = downloadURL(LatestURL)
            const Latest = getDictionary(LatestResponse)
            const LatestVersionValue = getValue(Latest, "version")
            @LatestVersion = "{LatestVersionValue}"
            if @LatestVersion == "" {
                alert("Could not read the latest version from {ProjectURL}.", "Check for updates")
                stop()
            }
            if @LatestVersion == AppVersion {
                alert("You have the latest version, {AppVersion}.", "Check for updates")
                stop()
            }
            const InstallLink = getValue(Latest, "install")
            menu "Version {@LatestVersion} is available. You have {AppVersion}." {
                item "Install update":
                    // Shortcuts' Replace adds a second copy instead of replacing this one, and adding the
                    // new version while this one exists names it "QR VCard Share 1".
                    alert("The new version opens next. Before adding it, delete this copy of QR VCard Share, so the new one keeps its name and your launchers keep working. Your profiles and settings are kept.", "Install update")
                    openURL("{InstallLink}")
                item "Not now":
                    nothing()
            }
            stop()
        item "Show project QR code":
            @Mode = "projectqr"
        item "Share project link":
            const ProjectLink = url(ProjectURL)
            share(ProjectLink)
            stop()
        item "Visit project site":
            openURL(ProjectURL)
            stop()
    }
}

// Shortcuts reads a .vcf back as a contact (just a name as text), so read it under a .txt name
// to get the vCard text itself.
@SourceVCard = ""
if @Source == "selftest" {
    #include 'selftest.cherri'
}
if @Source == "identity" {
    const IdentityFile = getFile("QRVCard/identity.vcf", nil, false)
    if IdentityFile {
        const IdentityTextFile = setName(IdentityFile, "identity.txt")
        @SourceVCard = getText(IdentityTextFile)
        #include 'identity_lookup.cherri'
    } else {
        // Managing profiles works without an identity; it just can't offer your custom labels.
        if @Mode != "profiles" {
            alert("No identity is set yet. Choose \"Set your Identity\" first.", "QR VCard Share")
            stop()
        }
    }
}
if @Source == "pick" {
    // A picked contact only becomes vCard text by way of a file, which is blanked afterwards
    // so another person's details are not left in iCloud Drive.
    const PickedContact = selectContact()
    saveFile("QRVCard/picked_contact.vcf", PickedContact, true)
    const PickedFile = getFile("QRVCard/picked_contact.vcf", nil, false)
    const PickedTextFile = setName(PickedFile, "picked_contact.txt")
    @SourceVCard = getText(PickedTextFile)
    const Blank = text(" ")
    saveFile("QRVCard/picked_contact.vcf", Blank, true)
}

#include 'vcard_parse.cherri'
@NeedsProfile = "yes"
if @Mode == "selftest" {
    @NeedsProfile = "no"
}
if @Mode == "projectqr" {
    @NeedsProfile = "no"
}
if @NeedsProfile == "yes" {
    #include 'profiles.cherri'

    if @Mode == "profiles" {
        #include 'profile_edit.cherri'
    }

    // Use the profile named in the input when it exists. The name is checked against the list
    // first because Get Dictionary Value fails on a missing key that contains ".".
    @ChosenProfileName = ""
    @Manual = "no"
    if @RequestedProfile != "" {
        const KnownNamesText = joinText(@ProfileNames, "\n")
        @KnownNames = "\n{KnownNamesText}\n"
        if @KnownNames contains "\n{@RequestedProfile}\n" {
            @ChosenProfileName = "{@RequestedProfile}"
        }
    }

    // Otherwise choose one. "Pick items manually" asks for every phone/email/address category even
    // where the profile's labels match, and remembers the answers for this contact.
    if @ChosenProfileName == "" {
        const ManualChoice = "Pick items manually…"
        @ProfileChoices: array
        for ListedChoice in @ProfileNames {
            @ProfileChoices += @ListedChoice
        }
        @ProfileChoices += ManualChoice
        const ChosenProfileItem = chooseFromList(@ProfileChoices, "Profile")
        @ChosenProfileName = "{ChosenProfileItem}"
        if @ChosenProfileName == ManualChoice {
            @Manual = "yes"
            const ManualProfileItem = chooseFromList(@ProfileNames, "Profile to start from")
            @ChosenProfileName = "{ManualProfileItem}"
        }
    }
    const ChosenProfileId = getValue(@ProfileIdFor, @ChosenProfileName)
    @ProfileId = "{ChosenProfileId}"
    const ChosenProfileFile = getFile("QRVCard/profiles/{@ProfileId}.json", nil, false)
    @Profile = getDictionary(ChosenProfileFile)
    @UseCache = "yes"
}

if @Mode == "projectqr" {
    // The project page as a QR card, drawn by the same renderer as contact cards.
    @VCardText = "{ProjectURL}"
    @CardDetailsHTML = "<div><b>QR VCard Share</b></div>\n<div>{ProjectURL}</div>\n<div>Version {AppVersion}</div>\n"
} else {
    #include 'select_lines.cherri'
    #include 'vcard_text.cherri'
}

if @Mode == "share" {
    // Show exactly what the .vcf holds before it can go anywhere; Cancel stops here.
    confirm(@CardDetailsText, "Share these details?")
    const VCardFile = setName(@VCardText, "{@VFullName}.vcf")
    share(VCardFile)
} else {
    #include 'card_image.cherri'
    if @Mode == "selftest" {
        output(CardImage)
    }
    quicklook(CardImage)
}

// Remember new answers only after the card is shown or shared: Shortcuts asks before writing
// contact-derived data to iCloud Drive, and that prompt should not come before the card.
if @CacheChanged == "yes" {
    createFolder("QRVCard/cache/{@ProfileId}")
    saveFile(@CachePath, @NewCache, true)
}
